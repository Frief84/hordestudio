      "factionId": "faction_new_faction_1",
      "startLocation": "loc_cell_1",
      "homeLocation": "loc_cell_1",
      "goal": "Her primary goal is to regain her freedom. She observes the guards, studies their routines, tests the boundaries of her confinement, and looks for opportunities to escape or persuade someone to release her.",
      "goalSteps": [
        "Alexis examines her locked cell for weaknesses and possible escape routes.",
        "She observes the guards and memorizes their daily routines.",
        "She attempts to communicate with other prisoners and persuade guards to help her.",
        "She secretly plans her escape but remains confined until a believable escape or authorized release occurs."
      ],
      "goalPool": [
